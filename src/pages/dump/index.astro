---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	dumpResources,
	describeResource,
	datapackageDescriptor,
	readPackageVersion,
	DATAPACKAGE_FILENAME,
} from '../../../scripts/compile.ts';
import { loadRegistry } from '../../lib/registry.ts';
import { UNSTABLE_BANNER } from '../../lib/banner.ts';

// `npm run build` runs `astro build` first and `scripts/compile.ts` second, so
// this page cannot read `dist/dump/datapackage.json` — the file does not exist
// yet. It calls the same two pure functions the compiler calls instead, over
// the same registry, so every number here is the number the descriptor
// publishes. Under `TEXTREFS_REGISTRY_FIXTURE=1` both sides read the fixture,
// and `build:fast` writes this page while `dist/dump/` stays empty. That build
// is a local fixture build and is never deployed.
const resources = dumpResources(loadRegistry()).map(describeResource);
// The descriptor normalises the version string, so read it from there rather
// than from `package.json` twice. `created` belongs to the written file alone,
// and the page never shows it.
const { version } = datapackageDescriptor(resources, readPackageVersion(), '');

const DESCRIPTIONS: Record<string, string> = {
	works: 'One Work record per line: the texts that get cited.',
	'citation-systems':
		'One CitationSystem record per line: the locator grammar of a citation tradition.',
	references:
		'One CanonicalReference record per line: a single point in a work under one citation system, with its resolver targets.',
	mappings:
		'One MappingAssertion record per line: a link from a work to an identifier in another system.',
	aliases:
		'The whole alias table as one JSON object. A key is a /cite/ alias path or an external identifier IRI; a value is the canonical IRI it resolves to.',
};

const PARSE_HINTS: Record<string, string> = {
	jsonl: 'Read line by line. Each line is one JSON object.',
	json: 'Read as one JSON document.',
};

function humanSize(bytes: number): string {
	if (bytes < 1024) return `${bytes} B`;
	if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
	return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}
---

<StarlightPage
	frontmatter={{
		title: 'Bulk downloads',
		description:
			'Every TextRefs record in one file: newline-delimited JSON dumps, the alias table, and a Frictionless data package with a byte count and a sha256 hash per file.',
		template: 'doc',
		tableOfContents: false,
		banner: UNSTABLE_BANNER,
	}}
>
	<p>
		<code>/dump/</code> carries the whole registry, rebuilt on every deploy. Read
		it instead of crawling the record pages: one request replaces thousands. The entry
		point is{' '}
		<a href="/dump/datapackage.json">
			<code>datapackage.json</code>
		</a>, a <a href="https://datapackage.org/">Frictionless</a> descriptor that names
		every file with its byte count and its <code>sha256</code> hash.
	</p>

	<p>
		These artifacts describe registry version <strong>{version}</strong>. The
		records are the same ones that <code>/id/</code> serves, without the JSON-LD{
			' '
		}<code>@context</code>. The <a href="/api/">API contract</a> documents the media
		types: the host serves a <code>.jsonl</code> body as{' '}
		<code>application/octet-stream</code>, so parse by documented shape, not by
		response header.
	</p>

	<div class="dump-table-wrap">
		<table>
			<thead>
				<tr>
					<th scope="col">File</th>
					<th scope="col">Contents</th>
					<th scope="col">Size</th>
					<th scope="col">sha256</th>
				</tr>
			</thead>
			<tbody>
				{
					resources.map((resource) => (
						<tr>
							<th scope="row">
								<a href={`/dump/${resource.path}`}>
									<code>{resource.path}</code>
								</a>
							</th>
							<td>
								{DESCRIPTIONS[resource.name]} {PARSE_HINTS[resource.format]}
							</td>
							<td>
								{humanSize(resource.bytes)}
								<br />
								<span class="dump-exact">{resource.bytes} bytes</span>
							</td>
							<td>
								<code class="dump-hash">
									{resource.hash.replace(/^sha256:/, '')}
								</code>
							</td>
						</tr>
					))
				}
				<tr>
					<th scope="row">
						<a href={`/dump/${DATAPACKAGE_FILENAME}`}>
							<code>{DATAPACKAGE_FILENAME}</code>
						</a>
					</th>
					<td>
						The manifest for the five files above: the same sizes and hashes,
						plus the registry version and the licence. Read as one JSON
						document.
					</td>
					<td colspan="2">
						<span class="dump-exact">
							Self-describing. It carries no size or hash of its own, because a
							hash cannot contain itself, and its <code>created</code> field changes
							on every build.
						</span>
					</td>
				</tr>
			</tbody>
		</table>
	</div>

	<h2>Verify a download</h2>

	<p>Recompute the hash and compare it with the descriptor:</p>

	<pre><code>curl -sO https://textrefs.org/dump/references.jsonl
shasum -a 256 references.jsonl</code></pre>

	<p>
		The six files above are registry data, and carry the{' '}
		<a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0</a>{
			' '
		}
		dedication that <code>datapackage.json</code> declares, as all TextRefs registry
		data does. This page is not one of them: the site code that renders it is licensed{
			' '
		}
		<a href="https://www.gnu.org/licenses/agpl-3.0.html">AGPL-3.0-or-later</a>.
	</p>
</StarlightPage>

<style>
	/* Hashes and the reference dump make this table wider than the prose column
	   on a narrow screen. Scroll the table, never the page. */
	.dump-table-wrap {
		overflow-x: auto;
	}
	.dump-hash {
		font-size: 0.75em;
		word-break: break-all;
	}
	.dump-exact {
		font-size: 0.8em;
		color: var(--sl-color-gray-3);
	}
</style>
